# Server
NODE_ENV=development
# 3002, weil das v1-Backend lokal schon auf 3001 läuft
PORT=3002
# Komma-getrennte Liste erlaubter Origins (Client, Capacitor)
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost

# PostgreSQL (17 oder neuer). Schema anlegen/aktualisieren: npm run db:migrate --workspace=@visit-flow/api
# In Produktion mit TLS, z. B. ?sslmode=require
DATABASE_URL=postgres://visitflow:visitflow@localhost:5432/visitflow

# Nur für Tests gegen eine echte Datenbank (jede Testdatei legt darin eine eigene Datenbank an)
# TEST_DATABASE_URL=postgres://visitflow:visitflow@localhost:5432/postgres

# Nur für die einmalige Übernahme aus v1 (npm run migrate:v1). Nutzer mit Mongo-Rolle "read".
# V1_MONGO_URI=mongodb://migration:…@host:27017/visitflow?authSource=admin

# Eigenes Secret für v2, mind. 32 Zeichen (muss nicht mehr dem von v1 entsprechen)
JWT_SECRET=

# Schlüssel für Feldverschlüsselung (AES-256-GCM) und Blind Index (HMAC). Zwei verschiedene Werte, je mind. 32 Zeichen.
DATA_CIPHER_KEY=
BLIND_INDEX_KEY=

# Aufbewahrung des Einwilligungs-Protokolls in Tagen (3 Jahre)
CONSENT_LOG_DAYS=1095
