# Server
NODE_ENV=development
# 3002, weil das v1-Backend lokal schon auf 3001 läuft
PORT=3002
# Komma-getrennte Liste erlaubter Origins (Client, Capacitor)
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost

# Gemeinsame Datenbank mit v1 (Parallelbetrieb)
MONGO_URI=mongodb://localhost:27017/visitflow

# Muss identisch mit JWT_SECRET von v1 sein, damit beide dieselben Access-Tokens akzeptieren
JWT_SECRET=

# Schlüssel für Feldverschlüsselung (AES-256-GCM) und Blind Index (HMAC). Zwei verschiedene Werte, je mind. 32 Zeichen.
DATA_CIPHER_KEY=
BLIND_INDEX_KEY=

# Aufbewahrung des Einwilligungs-Protokolls in Tagen (3 Jahre)
CONSENT_LOG_DAYS=1095

# Enes (KI-Coach) über Azure OpenAI, EU-Region wie in v1. Leer lassen: Enes antwortet nur mit lokalem Wissen.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21
# Aufbewahrung in Tagen: Gedächtnis von Enes und Gesprächsprotokoll
COPILOT_MEMORY_DAYS=180
COPILOT_LOG_DAYS=90
