# ============================================================
# ENVIRONMENT VARIABLE TEMPLATE (Visit Flow — Hybrid PostgreSQL & Zero-Trust)
# This file IS committed to git — it shows which variables
# are supported. Never put real secrets here.
#
# To set up locally:
#   cp .env.example .env.local
#   fill in the values in .env.local
# ============================================================

# ── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ── Hybrid PostgreSQL & DSGVO Verschlüsselung ───────────────
# "postgres" (sobald DATABASE_URL gesetzt ist) oder "file" (lokaler Fallback in ./data/visit-flow)
DATA_STORE_DRIVER=file
# PostgreSQL Connection String (DE/EU VPS oder Neon Frankfurt eu-central-1)
DATABASE_URL=
# AES-256-GCM Schlüssel für die Anwendungs-Verschlüsselung (mind. 32 Zeichen)
VF_DATA_KEY=

# ── Zero-Trust Auth & Session ───────────────────────────────
# Geheimnis (mind. 32 Zeichen) für die HMAC-SHA256 Signatur von __Host-vf_session
VF_SESSION_SECRET=
# Globaler Pepper für scrypt Passwort-Hashes
AUTH_PEPPER=

# ── Karte (Mapbox) ──────────────────────────────────────────
# Öffentlicher Mapbox-Schlüssel (pk.…)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
